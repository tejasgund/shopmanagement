<+>  <!DOCTYPE html>\r\n  <html lang=\"en\">\r\n  <head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\r\n  <title>Ledger — Shop &amp; Tenant Management</title>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\r\n  <style>\r\n  /* ============================================================\r\n     TOKENS\r\n     ============================================================ */\r\n  :root{\r\n    --ink:#15201B;\r\n    --paper:#F7F4EC;\r\n    --paper-raised:#FFFFFF;\r\n    --green:#2F6F4F;\r\n    --green-deep:#1F4D38;\r\n    --rust:#C0612B;\r\n    --rust-soft:#F3E3D6;\r\n    --line:#E8E2D2;\r\n    --success:#1F8A6B;\r\n    --success-soft:#E1F0E8;\r\n    --pending-soft:#F3E3D6;\r\n    --partial-soft:#FBEFD0;\r\n    --partial:#A87A12;\r\n    --muted:#6B6457;\r\n    --danger:#B43B2E;\r\n    --danger-soft:#F6E0DC;\r\n\r\n    --font-display:'Fraunces', serif;\r\n    --font-body:'Inter', system-ui, sans-serif;\r\n    --font-mono:'JetBrains Mono', monospace;\r\n\r\n    --radius:10px;\r\n    --radius-sm:6px;\r\n    --shadow-sm: 0 1px 2px rgba(21,32,27,0.06);\r\n    --shadow-md: 0 4px 16px rgba(21,32,27,0.10);\r\n    --shadow-lg: 0 12px 32px rgba(21,32,27,0.16);\r\n\r\n    --sidebar-w: 248px;\r\n  }\r\n\r\n  *{box-sizing:border-box;}\r\n  html,body{margin:0;padding:0;}\r\n  body{\r\n    background:var(--paper);\r\n    color:var(--ink);\r\n    font-family:var(--font-body);\r\n    font-size:15px;\r\n    line-height:1.5;\r\n    -webkit-font-smoothing:antialiased;\r\n    min-height:100vh;\r\n  }\r\n  h1,h2,h3,h4{font-family:var(--font-display); font-weight:600; margin:0; letter-spacing:-0.01em;}\r\n  .mono{font-family:var(--font-mono);}\r\n  a{color:inherit;}\r\n  button{font-family:var(--font-body); cursor:pointer;}\r\n  input,select,textarea{font-family:var(--font-body);}\r\n  *:focus-visible{outline:2px solid var(--green); outline-offset:2px; border-radius:4px;}\r\n\r\n  @media (prefers-reduced-motion: reduce){\r\n    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}\r\n  }\r\n\r\n  ::-webkit-scrollbar{width:10px; height:10px;}\r\n  ::-webkit-scrollbar-thumb{background:var(--line); border-radius:6px;}\r\n  ::-webkit-scrollbar-track{background:transparent;}\r\n\r\n  /* ============================================================\r\n     LOGIN SCREEN\r\n     ============================================================ */\r\n  .login-wrap{\r\n    min-height:100vh;\r\n    display:flex;\r\n    align-items:center;\r\n    justify-content:center;\r\n    padding:24px;\r\n    background:\r\n      radial-gradient(900px 600px at 15% -10%, rgba(47,111,79,0.10), transparent 60%),\r\n      radial-gradient(700px 500px at 110% 110%, rgba(192,97,43,0.08), transparent 60%),\r\n      var(--paper);\r\n  }\r\n  .login-card{\r\n    width:100%;\r\n    max-width:400px;\r\n    background:var(--paper-raised);\r\n    border:1px solid var(--line);\r\n    border-radius:var(--radius);\r\n    box-shadow:var(--shadow-lg);\r\n    padding:40px 32px;\r\n    animation:rise 0.5s ease both;\r\n  }\r\n  @keyframes rise{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }\r\n  .login-mark{\r\n    display:flex; align-items:center; gap:10px; margin-bottom:28px;\r\n  }\r\n  .login-mark .stamp-mark{\r\n    width:38px; height:38px; border-radius:8px;\r\n    background:var(--ink); color:var(--paper);\r\n    display:flex; align-items:center; justify-content:center;\r\n    font-family:var(--font-display); font-weight:700; font-size:18px;\r\n    transform:rotate(-4deg);\r\n  }\r\n  .login-mark .wordmark{font-size:21px;}\r\n  .login-mark .wordmark span{color:var(--green); font-style:italic;}\r\n  .login-card h1{font-size:24px; margin-bottom:4px;}\r\n  .login-sub{color:var(--muted); font-size:13.5px; margin-bottom:28px;}\r\n  .field{margin-bottom:18px;}\r\n  .field label{\r\n    display:block; font-size:12.5px; font-weight:600; text-transform:uppercase;\r\n    letter-spacing:0.04em; color:var(--muted); margin-bottom:7px;\r\n  }\r\n  .field input{\r\n    width:100%; padding:11px 13px; border:1.5px solid var(--line);\r\n    border-radius:var(--radius-sm); font-size:15px; background:var(--paper-raised);\r\n    transition:border-color .15s ease;\r\n  }\r\n  .field input:focus{border-color:var(--green);}\r\n  .pw-row{position:relative;}\r\n  .pw-toggle{\r\n    position:absolute; right:10px; top:50%; transform:translateY(-50%);\r\n    background:none; border:none; font-size:12px; color:var(--muted); font-weight:600;\r\n    padding:4px 6px;\r\n  }\r\n  .btn{\r\n    display:inline-flex; align-items:center; justify-content:center; gap:8px;\r\n    padding:11px 18px; border-radius:var(--radius-sm); border:none;\r\n    font-weight:600; font-size:14px; transition:transform .12s ease, box-shadow .12s ease, background .15s ease;\r\n    white-space:nowrap;\r\n  }\r\n  .btn:active{transform:scale(0.97);}\r\n  .btn-primary{background:var(--green); color:#fff;}\r\n  .btn-primary:hover{background:var(--green-deep);}\r\n  .btn-primary:disabled{background:#9FB8AB; cursor:not-allowed; transform:none;}\r\n  .btn-block{width:100%;}\r\n  .btn-ghost{background:transparent; color:var(--ink); border:1.5px solid var(--line);}\r\n  .btn-ghost:hover{border-color:var(--ink);}\r\n  .btn-danger-ghost{background:transparent; color:var(--danger); border:1.5px solid var(--danger-soft);}\r\n  .btn-danger-ghost:hover{background:var(--danger-soft);}\r\n  .btn-sm{padding:6px 11px; font-size:12.5px;}\r\n  .btn-icon{padding:8px; border-radius:var(--radius-sm); background:transparent; border:1.5px solid var(--line); color:var(--ink); display:inline-flex;}\r\n  .btn-icon:hover{border-color:var(--green); color:var(--green);}\r\n  .btn-icon.spinning svg{animation:spin 0.7s linear infinite;}\r\n  @keyframes spin{ to{ transform:rotate(360deg); } }\r\n\r\n  .login-error{\r\n    background:var(--danger-soft); color:var(--danger); border-radius:var(--radius-sm);\r\n    padding:10px 13px; font-size:13px; margin-bottom:16px; display:none; font-weight:500;\r\n  }\r\n  .login-error.show{display:block; animation:shake .3s ease;}\r\n  @keyframes shake{ 0%,100%{transform:translateX(0);} 25%{transform:translateX(-4px);} 75%{transform:translateX(4px);} }\r\n\r\n  .api-base-note{\r\n    margin-top:22px; padding-top:16px; border-top:1px dashed var(--line);\r\n    font-size:11.5px; color:var(--muted); display:flex; justify-content:space-between; gap:8px;\r\n  }\r\n  .api-base-note code{font-family:var(--font-mono); background:var(--paper); padding:2px 6px; border-radius:4px;}\r\n\r\n  /* ============================================================\r\n     APP SHELL\r\n     ============================================================ */\r\n  .app{ display:none; min-height:100vh; }\r\n  .app.show{ display:flex; }\r\n\r\n  .sidebar{\r\n    width:var(--sidebar-w); flex-shrink:0; background:var(--ink); color:var(--paper);\r\n    display:flex; flex-direction:column; padding:22px 14px; position:fixed; top:0; left:0; bottom:0; overflow-y:auto;\r\n  }\r\n  .sidebar-mark{ display:flex; align-items:center; gap:10px; padding:0 8px 24px; }\r\n  .sidebar-mark .stamp-mark{\r\n    width:32px; height:32px; border-radius:7px; background:var(--green); color:#fff;\r\n    display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; font-size:15px;\r\n    transform:rotate(-4deg); flex-shrink:0;\r\n  }\r\n  .sidebar-mark .wordmark{font-size:17px; color:#fff;}\r\n  .sidebar-mark .wordmark span{color:#6FBE99; font-style:italic;}\r\n\r\n  .nav-group{ margin-bottom:4px; }\r\n  .nav-label{ font-size:10.5px; text-transform:uppercase; letter-spacing:.08em; color:#8A9389; padding:14px 12px 6px; font-weight:600;}\r\n  .nav-item{\r\n    display:flex; align-items:center; gap:11px; padding:10px 12px; border-radius:var(--radius-sm);\r\n    color:#C9CFC5; font-size:14px; font-weight:500; margin-bottom:2px; transition:background .12s ease, color .12s ease;\r\n    border:none; background:none; width:100%; text-align:left;\r\n  }\r\n  .nav-item svg{ flex-shrink:0; opacity:0.85; }\r\n  .nav-item:hover{ background:rgba(255,255,255,0.06); color:#fff; }\r\n  .nav-item.active{ background:var(--green); color:#fff; }\r\n  .nav-item.active svg{ opacity:1; }\r\n  .nav-badge{\r\n    margin-left:auto; background:var(--rust); color:#fff; font-size:10.5px; font-weight:700;\r\n    padding:1px 6px; border-radius:10px; min-width:18px; text-align:center;\r\n  }\r\n\r\n  .sidebar-foot{ margin-top:auto; padding-top:16px; border-top:1px solid rgba(255,255,255,0.08); }\r\n  .user-chip{ display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:var(--radius-sm); }\r\n  .user-avatar{\r\n    width:32px; height:32px; border-radius:50%; background:var(--green); color:#fff;\r\n    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; flex-shrink:0;\r\n  }\r\n  .user-meta{ overflow:hidden; }\r\n  .user-meta .name{ font-size:13.5px; color:#fff; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\r\n  .user-meta .role{ font-size:11px; color:#8A9389; text-transform:capitalize; }\r\n  .logout-btn{\r\n    width:100%; margin-top:8px; background:none; border:1.5px solid rgba(255,255,255,0.14); color:#C9CFC5;\r\n    padding:9px; border-radius:var(--radius-sm); font-size:13px; font-weight:600; display:flex; align-items:center; justify-content:center; gap:7px;\r\n  }\r\n  .logout-btn:hover{ border-color:var(--rust); color:#fff; background:rgba(192,97,43,0.15); }\r\n\r\n  .main{ flex:1; margin-left:var(--sidebar-w); min-width:0; }\r\n  .topbar{\r\n    position:sticky; top:0; z-index:20; background:rgba(247,244,236,0.92); backdrop-filter:blur(8px);\r\n    border-bottom:1px solid var(--line); padding:16px 28px; display:flex; align-items:center; justify-content:space-between; gap:16px;\r\n  }\r\n  .topbar h2{ font-size:21px; }\r\n  .topbar .crumb{ font-size:12.5px; color:var(--muted); margin-top:2px; }\r\n  .topbar-actions{ display:flex; align-items:center; gap:10px; }\r\n  .content{ padding:24px 28px 56px; max-width:1320px; }\r\n\r\n  .menu-toggle{ display:none; background:none; border:none; padding:6px; color:var(--ink); }\r\n\r\n  /* ============================================================\r\n     GENERIC UI PARTS\r\n     ============================================================ */\r\n  .toolbar{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:18px; flex-wrap:wrap; }\r\n  .search-input{\r\n    flex:1; min-width:180px; max-width:340px; padding:9px 13px 9px 36px; border:1.5px solid var(--line);\r\n    border-radius:var(--radius-sm); font-size:13.5px; background:var(--paper-raised) url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"%236B6457\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>') no-repeat 12px center;\r\n  }\r\n  .search-input:focus{ border-color:var(--green); outline:none; }\r\n  .filter-chips{ display:flex; gap:6px; }\r\n  .chip{\r\n    padding:7px 13px; border-radius:999px; border:1.5px solid var(--line); background:var(--paper-raised);\r\n    font-size:12.5px; font-weight:600; color:var(--muted); transition:all .12s ease;\r\n  }\r\n  .chip:hover{ border-color:var(--green); color:var(--ink); }\r\n  .chip.active{ background:var(--ink); color:#fff; border-color:var(--ink); }\r\n  .tenant-tag{ font-size:13px; font-weight:600; color:var(--green-deep); }\r\n\r\n  .card{ background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow-sm); }\r\n  .card-pad{ padding:18px; }\r\n\r\n  .stat-row{ display:grid; grid-template-columns:repeat(auto-fit, minmax(170px,1fr)); gap:14px; margin-bottom:20px; }\r\n  .stat-card{ padding:16px 18px; }\r\n  .stat-card .label{ font-size:11.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; margin-bottom:8px;}\r\n  .stat-card .value{ font-family:var(--font-display); font-size:26px; font-weight:600; }\r\n  .stat-card .sub{ font-size:12px; color:var(--muted); margin-top:4px; }\r\n  .stat-card.accent-green .value{ color:var(--green-deep); }\r\n  .stat-card.accent-rust .value{ color:var(--rust); }\r\n  .glance-card{ font-family:inherit; transition:border-color .12s, transform .1s; }\r\n  .glance-card:hover{ border-color:var(--green); }\r\n  .glance-card:active{ transform:scale(0.98); }\r\n\r\n  .table-wrap{ overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper-raised); }\r\n  table{ width:100%; border-collapse:collapse; font-size:13.8px; min-width:640px; }\r\n  thead th{\r\n    text-align:left; padding:12px 16px; font-size:11.5px; text-transform:uppercase; letter-spacing:.04em;\r\n    color:var(--muted); font-weight:600; border-bottom:1.5px solid var(--line); white-space:nowrap; background:#FBF9F4;\r\n  }\r\n  tbody td{ padding:13px 16px; border-bottom:1px solid var(--line); vertical-align:middle; }\r\n  tbody tr:last-child td{ border-bottom:none; }\r\n  tbody tr{ transition:background .1s ease; }\r\n  tbody tr:hover{ background:#FBF9F4; }\r\n  td.num, th.num{ text-align:right; font-family:var(--font-mono); }\r\n  td .row-actions{ display:flex; gap:6px; justify-content:flex-end; }\r\n\r\n  .pill{\r\n    display:inline-flex; align-items:center; gap:5px; padding:3px 10px; border-radius:999px;\r\n    font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.03em;\r\n  }\r\n  .pill-dot{ width:6px; height:6px; border-radius:50%; }\r\n  .pill.available{ background:var(--success-soft); color:var(--success); }\r\n  .pill.available .pill-dot{ background:var(--success); }\r\n  .pill.occupied{ background:#E7E3F4; color:#5B4B9E; }\r\n  .pill.occupied .pill-dot{ background:#5B4B9E; }\r\n  .pill.active-pill{ background:var(--success-soft); color:var(--success); }\r\n  .pill.active-pill .pill-dot{ background:var(--success); }\r\n  .pill.inactive-pill{ background:var(--danger-soft); color:var(--danger); }\r\n  .pill.inactive-pill .pill-dot{ background:var(--danger); }\r\n  .pill.role-admin{ background:#FDEBD8; color:#9A5A12; }\r\n  .pill.role-tenant{ background:#E3EEFB; color:#1E5C9A; }\r\n\r\n  /* stamp badge — signature element for bill/payment status */\r\n  .stamp{\r\n    display:inline-flex; align-items:center; justify-content:center;\r\n    font-family:var(--font-mono); font-weight:700; font-size:10.5px; letter-spacing:.06em;\r\n    padding:4px 10px; border-radius:4px; border:2px solid currentColor;\r\n    transform:rotate(-3deg); text-transform:uppercase;\r\n  }\r\n  .stamp.paid{ color:var(--success); }\r\n  .stamp.partial{ color:var(--partial); }\r\n  .stamp.pending{ color:var(--rust); }\r\n\r\n  .empty-state{ text-align:center; padding:64px 24px; color:var(--muted); }\r\n  .empty-state svg{ opacity:0.4; margin-bottom:14px; }\r\n  .empty-state h3{ font-size:16px; color:var(--ink); margin-bottom:6px; }\r\n  .empty-state p{ font-size:13.5px; max-width:340px; margin:0 auto; }\r\n\r\n  .skeleton-row{ height:46px; background:linear-gradient(90deg, #EFEBE0 25%, #F6F3EA 37%, #EFEBE0 63%); background-size:400% 100%; animation:shimmer 1.4s ease infinite; border-bottom:1px solid var(--line); }\r\n  @keyframes shimmer{ 0%{background-position:100% 0;} 100%{background-position:0 0;} }\r\n\r\n  .error-banner{\r\n    background:var(--danger-soft); color:var(--danger); border-radius:var(--radius-sm); padding:13px 16px;\r\n    font-size:13.5px; font-weight:500; margin-bottom:16px; display:flex; align-items:flex-start; gap:10px;\r\n  }\r\n  .error-banner svg{ flex-shrink:0; margin-top:1px; }\r\n  .error-banner button{ margin-left:auto; background:none; border:none; color:var(--danger); font-weight:700; font-size:16px; line-height:1; flex-shrink:0;}\r\n\r\n  /* Toasts */\r\n  .toast-stack{ position:fixed; bottom:20px; right:20px; z-index:1000; display:flex; flex-direction:column; gap:10px; max-width:340px; }\r\n  .toast{\r\n    background:var(--ink); color:#fff; padding:13px 16px; border-radius:var(--radius-sm); box-shadow:var(--shadow-lg);\r\n    font-size:13.5px; font-weight:500; display:flex; align-items:center; gap:10px; animation:toast-in .25s ease both;\r\n  }\r\n  .toast.success{ background:var(--green-deep); }\r\n  .toast.error{ background:var(--danger); }\r\n  .toast.fade-out{ animation:toast-out .25s ease forwards; }\r\n  @keyframes toast-in{ from{opacity:0; transform:translateX(20px);} to{opacity:1; transform:translateX(0);} }\r\n  @keyframes toast-out{ from{opacity:1;} to{opacity:0; transform:translateX(20px);} }\r\n\r\n  /* Modal */\r\n  .modal-overlay{\r\n    position:fixed; inset:0; background:rgba(21,32,27,0.45); display:none; align-items:center; justify-content:center;\r\n    z-index:500; padding:20px; backdrop-filter:blur(2px);\r\n  }\r\n  .modal-overlay.show{ display:flex; animation:fade-in .15s ease; }\r\n  @keyframes fade-in{ from{opacity:0;} to{opacity:1;} }\r\n  .modal{\r\n    background:var(--paper-raised); border-radius:var(--radius); box-shadow:var(--shadow-lg); width:100%; max-width:560px;\r\n    max-height:90vh; overflow-y:auto; animation:modal-in .2s ease both;\r\n  }\r\n  @keyframes modal-in{ from{opacity:0; transform:translateY(12px) scale(0.98);} to{opacity:1; transform:translateY(0) scale(1);} }\r\n  .modal-head{ padding:20px 22px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; }\r\n  .modal-head h3{ font-size:18px; }\r\n  .modal-close{ background:none; border:none; color:var(--muted); padding:4px; }\r\n  .modal-close:hover{ color:var(--ink); }\r\n  .modal-body{ padding:22px; }\r\n  .modal-foot{ padding:16px 22px; border-top:1px solid var(--line); display:flex; justify-content:flex-end; gap:10px; }\r\n  .form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }\r\n  .form-grid .full{ grid-column:1 / -1; }\r\n  @media (max-width:520px){ .form-grid{ grid-template-columns:1fr; } }\r\n  .field select, .field textarea{\r\n    width:100%; padding:11px 13px; border:1.5px solid var(--line); border-radius:var(--radius-sm); font-size:14.5px; background:var(--paper-raised);\r\n  }\r\n  .field select:disabled{ background:#F4F1E9; color:var(--muted); cursor:not-allowed; }\r\n  .field textarea{ resize:vertical; min-height:64px; font-family:var(--font-body); }\r\n  .field .hint{ font-size:11.5px; color:var(--muted); margin-top:5px; }\r\n  .field-error{ font-size:12px; color:var(--danger); margin-top:5px; font-weight:600; }\r\n  .field input.invalid, .field select.invalid{ border-color:var(--danger); }\r\n\r\n  .confirm-body{ padding:22px; font-size:14.5px; }\r\n  .confirm-body strong{ font-weight:700; }\r\n\r\n  /* ---- Info card used inside modals ---- */\r\n  .info-card{\r\n    background:var(--paper); border:1.5px solid var(--line); border-radius:var(--radius-sm);\r\n    padding:12px 14px; margin-top:4px; font-size:13px;\r\n  }\r\n  .info-card .info-row{ display:flex; justify-content:space-between; align-items:center; gap:10px; padding:3px 0; }\r\n  .info-card .info-label{ color:var(--muted); font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:.03em; }\r\n  .info-card .info-val{ font-weight:600; font-family:var(--font-mono); font-size:13px; }\r\n  .info-card .info-val.good{ color:var(--success); }\r\n  .info-card .info-val.warn{ color:var(--rust); }\r\n\r\n  /* ---- Step / path toggle inside modal ---- */\r\n  .path-toggle{\r\n    display:flex; gap:0; border:1.5px solid var(--line); border-radius:var(--radius-sm); overflow:hidden; margin-bottom:18px;\r\n  }\r\n  .path-btn{\r\n    flex:1; padding:10px 12px; background:var(--paper-raised); border:none; font-size:13.5px; font-weight:600;\r\n    color:var(--muted); cursor:pointer; transition:background .12s, color .12s; border-right:1.5px solid var(--line);\r\n    display:flex; align-items:center; justify-content:center; gap:7px;\r\n  }\r\n  .path-btn:last-child{ border-right:none; }\r\n  .path-btn.active{ background:var(--ink); color:#fff; }\r\n  .path-btn:hover:not(.active){ background:var(--paper); color:var(--ink); }\r\n\r\n  /* ---- Bill section inside payment modal ---- */\r\n  .bill-list{ display:flex; flex-direction:column; gap:8px; margin-top:6px; }\r\n  .bill-row{\r\n    border:1.5px solid var(--line); border-radius:var(--radius-sm); padding:11px 13px;\r\n    cursor:pointer; transition:border-color .12s, background .12s; display:flex; align-items:center; gap:12px;\r\n  }\r\n  .bill-row:hover{ border-color:var(--green); background:#F2F9F5; }\r\n  .bill-row.selected{ border-color:var(--green); background:#E8F4EE; }\r\n  .bill-row input[type=radio]{ accent-color:var(--green); width:15px; height:15px; flex-shrink:0; }\r\n  .bill-row-info{ flex:1; min-width:0; }\r\n  .bill-row-info .btype{ font-weight:700; font-size:13.5px; }\r\n  .bill-row-info .bmeta{ font-size:12px; color:var(--muted); margin-top:2px; }\r\n  .bill-row-amt{ text-align:right; flex-shrink:0; }\r\n  .bill-row-amt .bpending{ font-family:var(--font-mono); font-weight:700; font-size:14px; color:var(--rust); }\r\n  .bill-row-amt .bdue{ font-size:11.5px; color:var(--muted); margin-top:2px; }\r\n\r\n  /* ---- Unoccupied warning ---- */\r\n  .warn-box{\r\n    background:var(--rust-soft); border:1.5px solid #E8C4A8; border-radius:var(--radius-sm);\r\n    padding:11px 14px; font-size:13px; color:#7A3A18; display:flex; align-items:flex-start; gap:9px; margin-top:4px;\r\n  }\r\n  .warn-box svg{ flex-shrink:0; margin-top:1px; }\r\n\r\n  /* ---- Payment summary before save ---- */\r\n  .pay-summary{\r\n    background:var(--success-soft); border:1.5px solid #A8D9C4; border-radius:var(--radius-sm);\r\n    padding:13px 15px; margin-top:6px;\r\n  }\r\n  .pay-summary .ps-title{ font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--success); margin-bottom:8px; }\r\n  .pay-summary .ps-row{ display:flex; justify-content:space-between; font-size:13px; padding:3px 0; }\r\n  .pay-summary .ps-row .ps-key{ color:var(--muted); }\r\n  .pay-summary .ps-row .ps-val{ font-weight:600; }\r\n  .pay-summary .ps-row.ps-total .ps-val{ font-family:var(--font-mono); font-size:15px; color:var(--green-deep); }\r\n\r\n  /* Tenant portal (read-only, simplified) */\r\n  .tenant-shell{ width:100%; }\r\n  .tenant-topbar{\r\n    background:var(--ink); color:#fff; padding:18px 24px; display:flex; align-items:center; justify-content:space-between;\r\n    position:sticky; top:0; z-index:20;\r\n  }\r\n  .tenant-content{ max-width:760px; margin:0 auto; padding:24px 18px 64px; }\r\n  .section-title{ font-size:17px; margin:28px 0 14px; display:flex; align-items:center; justify-content:space-between; }\r\n  .tenant-card{ background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius); padding:16px 18px; margin-bottom:10px; box-shadow:var(--shadow-sm); }\r\n  .tenant-card .row1{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:8px;}\r\n  .tenant-card .title{ font-weight:600; font-size:14.5px; }\r\n  .tenant-card .meta{ font-size:12.5px; color:var(--muted); }\r\n  .tenant-card .amt-row{ display:flex; justify-content:space-between; font-size:13px; padding-top:8px; border-top:1px dashed var(--line); margin-top:8px;}\r\n  .tenant-card .amt-row .big{ font-family:var(--font-mono); font-weight:700; font-size:15px; }\r\n\r\n  .spinner{ width:16px; height:16px; border:2.5px solid rgba(255,255,255,0.35); border-top-color:#fff; border-radius:50%; animation:spin 0.7s linear infinite; }\r\n  .spinner.dark{ border:2.5px solid rgba(21,32,27,0.2); border-top-color:var(--ink); }\r\n\r\n  .checkbox-list{ display:flex; flex-direction:column; gap:8px; max-height:220px; overflow-y:auto; border:1.5px solid var(--line); border-radius:var(--radius-sm); padding:10px; }\r\n  .checkbox-row{ display:flex; align-items:center; gap:9px; font-size:13.5px; padding:5px 6px; border-radius:5px; }\r\n  .checkbox-row:hover{ background:var(--paper); }\r\n  .checkbox-row input{ width:16px; height:16px; accent-color:var(--green); }\r\n\r\n  /* ---- Shop picker list (bulk bill creation) ---- */\r\n  .shop-pick-list{ display:flex; flex-direction:column; gap:7px; max-height:280px; overflow-y:auto; padding:2px; }\r\n  .shop-pick-row{\r\n    display:flex; align-items:center; gap:11px; padding:10px 12px; border:1.5px solid var(--line);\r\n    border-radius:var(--radius-sm); cursor:pointer; transition:border-color .12s, background .12s;\r\n  }\r\n  .shop-pick-row:hover{ border-color:var(--green); }\r\n  .shop-pick-row.checked-row{ border-color:var(--green); background:#F2F9F5; }\r\n  .shop-pick-check{ width:17px; height:17px; accent-color:var(--green); flex-shrink:0; cursor:pointer; }\r\n  .shop-pick-info{ flex:1; min-width:0; }\r\n  .shop-pick-num{ font-weight:700; font-size:14px; }\r\n  .shop-pick-meta{ font-size:11.5px; color:var(--muted); margin-top:2px; }\r\n  .shop-pick-amt-wrap{ display:flex; align-items:center; gap:4px; flex-shrink:0; }\r\n  .shop-pick-rupee{ font-family:var(--font-mono); color:var(--muted); font-size:13px; }\r\n  .shop-pick-amount{\r\n    width:104px; padding:8px 9px; border:1.5px solid var(--line); border-radius:var(--radius-sm);\r\n    font-family:var(--font-mono); font-size:13.5px; text-align:right; background:var(--paper-raised);\r\n  }\r\n  .shop-pick-amount:focus{ border-color:var(--green); outline:none; }\r\n  @media (max-width:480px){\r\n    .shop-pick-row{ flex-wrap:wrap; }\r\n    .shop-pick-amt-wrap{ width:100%; justify-content:flex-end; margin-left:28px; }\r\n  }\r\n\r\n  .visually-hidden{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }\r\n\r\n  /* Responsive */\r\n  @media (max-width:900px){\r\n    .sidebar{ transform:translateX(-100%); transition:transform .2s ease; z-index:300; box-shadow:var(--shadow-lg); }\r\n    .sidebar.open{ transform:translateX(0); }\r\n    .main{ margin-left:0; }\r\n    .menu-toggle{ display:flex; }\r\n    .sidebar-scrim{ display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:290; }\r\n    .sidebar-scrim.show{ display:block; }\r\n    .content{ padding:18px 16px 90px; }\r\n    .topbar{ padding:14px 16px; }\r\n  }\r\n  @media (max-width:560px){\r\n    .topbar h2{ font-size:18px; }\r\n    .stat-row{ grid-template-columns:repeat(2,1fr); }\r\n    table{ font-size:13px; }\r\n    thead th, tbody td{ padding:10px 12px; }\r\n    .modal-overlay{ padding:0; align-items:flex-end; }\r\n    .modal{ max-width:100%; max-height:92vh; border-radius:var(--radius) var(--radius) 0 0; animation:modal-in-sheet .2s ease both; }\r\n    .modal-head{ padding:16px 16px 14px; }\r\n    .modal-body{ padding:16px; }\r\n    .modal-foot{ padding:12px 16px; padding-bottom:max(12px, env(safe-area-inset-bottom)); flex-wrap:wrap; }\r\n    .modal-foot .btn{ flex:1; }\r\n    .pay-summary, .info-card, .warn-box{ padding:11px 12px; }\r\n  }\r\n  @keyframes modal-in-sheet{ from{opacity:0; transform:translateY(24px);} to{opacity:1; transform:translateY(0);} }\r\n\r\n  /* ============================================================\r\n     ENHANCED UI — filters, advanced search, user dashboard\r\n     ============================================================ */\r\n  .filter-bar{\r\n    background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius);\r\n    padding:14px 16px; margin-bottom:18px; display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end;\r\n  }\r\n  .filter-bar .field{ margin:0; min-width:130px; flex:1; }\r\n  .filter-bar .field label{ font-size:11px; }\r\n  .filter-bar .field input,.filter-bar .field select{ font-size:13px; padding:8px 10px; }\r\n  .filter-bar .field.search-full{ flex:2; min-width:200px; }\r\n  .filter-count{ font-size:12.5px; color:var(--muted); font-weight:600; margin-left:auto; align-self:center; white-space:nowrap; }\r\n  .filter-clear-btn{ padding:8px 13px; font-size:12.5px; font-weight:600; white-space:nowrap; }\r\n\r\n  .sort-select{ padding:8px 10px; border:1.5px solid var(--line); border-radius:var(--radius-sm); font-size:13px; background:var(--paper-raised); color:var(--ink); }\r\n\r\n  /* Dashboard complex stats table */\r\n  .complex-stat-card{\r\n    background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius);\r\n    padding:14px 16px; box-shadow:var(--shadow-sm); transition:box-shadow .15s;\r\n  }\r\n  .complex-stat-card:hover{ box-shadow:var(--shadow-md); }\r\n  .complex-stat-card .c-name{ font-weight:700; font-size:14.5px; margin-bottom:10px; display:flex; align-items:center; gap:8px; }\r\n  .complex-stat-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }\r\n  .complex-stat-item{ text-align:center; }\r\n  .complex-stat-item .csi-val{ font-family:var(--font-mono); font-weight:700; font-size:16px; }\r\n  .complex-stat-item .csi-label{ font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; font-weight:600; }\r\n  .complex-stat-item.accent-green .csi-val{ color:var(--green-deep); }\r\n  .complex-stat-item.accent-rust .csi-val{ color:var(--rust); }\r\n\r\n  /* Collapsible sections for tenant portal */\r\n  .collapsible-section{ background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius); margin-bottom:12px; overflow:hidden; }\r\n  .collapsible-header{ display:flex; align-items:center; justify-content:space-between; padding:14px 18px; cursor:pointer; user-select:none; }\r\n  .collapsible-header h3{ font-size:15px; margin:0; }\r\n  .collapsible-arrow{ transition:transform .2s; }\r\n  .collapsible-header.open .collapsible-arrow{ transform:rotate(180deg); }\r\n  .collapsible-body{ display:none; border-top:1px solid var(--line); padding:16px 18px; }\r\n  .collapsible-body.open{ display:block; }\r\n\r\n  /* Tenant portal enhanced stats */\r\n  .tp-stat-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-bottom:16px; }\r\n  .tp-stat{ background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius); padding:12px 14px; }\r\n  .tp-stat .tp-label{ font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; margin-bottom:4px; }\r\n  .tp-stat .tp-value{ font-family:var(--font-display); font-size:20px; font-weight:600; }\r\n  .tp-stat.accent-green .tp-value{ color:var(--green-deep); }\r\n  .tp-stat.accent-rust .tp-value{ color:var(--rust); }\r\n  .tp-stat.accent-partial .tp-value{ color:var(--partial); }\r\n  @media(min-width:500px){ .tp-stat-grid{ grid-template-columns:repeat(4,1fr); } }\r\n\r\n  /* Monthly summary for tenant portal */\r\n  .month-row{\r\n    border:1px solid var(--line); border-radius:var(--radius-sm); margin-bottom:8px; overflow:hidden;\r\n  }\r\n  .month-row-head{ display:flex; align-items:center; justify-content:space-between; padding:10px 14px; cursor:pointer; background:var(--paper-raised); }\r\n  .month-row-head .m-name{ font-weight:700; font-size:13.5px; }\r\n  .month-row-head .m-badges{ display:flex; gap:8px; align-items:center; }\r\n  .month-row-body{ display:none; border-top:1px solid var(--line); padding:12px 14px; background:#FAFAF8; }\r\n  .month-row-body.open{ display:block; }\r\n\r\n  /* Bills/Payments year→month drill-down */\r\n  .drill-crumb{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; font-size:12.5px; color:var(--muted); margin-bottom:12px; }\r\n  .drill-crumb span{ cursor:pointer; }\r\n  .drill-crumb span.active{ color:var(--ink); font-weight:700; cursor:default; }\r\n  .drill-crumb .sep{ color:var(--line); cursor:default; }\r\n  .drill-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:10px; }\r\n  .drill-card{ background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius); padding:14px 16px; cursor:pointer; transition:border-color .12s, box-shadow .12s; }\r\n  .drill-card:hover{ border-color:var(--green); box-shadow:var(--shadow-sm); }\r\n  .drill-card .dc-title{ font-weight:700; font-size:15px; margin-bottom:6px; }\r\n  .drill-card .dc-count{ font-size:11.5px; color:var(--muted); margin-bottom:8px; }\r\n  .drill-card .dc-amt{ font-family:var(--font-mono); font-weight:700; font-size:15px; }\r\n  .drill-card .dc-pending{ font-size:11.5px; color:var(--rust); font-weight:600; margin-top:3px; }\r\n  .drill-card .dc-pending.clear{ color:var(--success); }\r\n  @media (max-width:480px){ .drill-grid{ grid-template-columns:repeat(2,1fr); gap:8px; } .drill-card{ padding:11px 12px; } }\r\n\r\n  /* Finance page user card */\r\n  .user-finance-card{ background:var(--paper-raised); border:1.5px solid var(--green); border-radius:var(--radius); padding:16px 18px; margin-bottom:16px; }\r\n  .user-finance-card .ufc-name{ font-weight:700; font-size:16px; margin-bottom:2px; }\r\n  .user-finance-card .ufc-meta{ font-size:12.5px; color:var(--muted); }\r\n\r\n  /* Deposit section in tenant portal */\r\n  .deposit-progress{ margin:12px 0; }\r\n  .deposit-bar-wrap{ background:var(--line); border-radius:999px; height:8px; overflow:hidden; margin-top:6px; }\r\n  .deposit-bar{ background:var(--green); height:100%; border-radius:999px; transition:width .4s ease; }\r\n\r\n  /* Records count tag */\r\n  .record-count-tag{ background:var(--paper); border:1px solid var(--line); border-radius:999px; padding:3px 10px; font-size:12px; font-weight:600; color:var(--muted); }\r\n\r\n  /* Empty state compact */\r\n  .empty-compact{ text-align:center; padding:28px 16px; color:var(--muted); font-size:13.5px; }\r\n\r\n  /* Year selector for tenant */\r\n  .year-btn-row{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px; }\r\n  .year-btn{ padding:7px 14px; border-radius:999px; border:1.5px solid var(--line); background:var(--paper-raised); font-size:13px; font-weight:600; color:var(--muted); cursor:pointer; transition:all .12s; }\r\n  .year-btn.active{ background:var(--ink); color:#fff; border-color:var(--ink); }\r\n  .year-btn:hover:not(.active){ border-color:var(--ink); color:var(--ink); }\r\n  </style>\r\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js\"></script>\r\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js\"></script>\r\n  </head>\r\n  <body>\r\n\r\n  <!-- ============================================================\r\n       LOGIN SCREEN\r\n       ============================================================ -->\r\n  <div class=\"login-wrap\" id=\"loginScreen\">\r\n    <div class=\"login-card\">\r\n      <div class=\"login-mark\">\r\n        <div class=\"stamp-mark\">Hi</div>\r\n        <div class=\"wordmark\">Sahyadri Buisness Park<span>.</span></div>\r\n      </div>\r\n      <h1>Sign in</h1>\r\n      <p class=\"login-sub\">Manage complexes, shops, tenants and bills.</p>\r\n\r\n      <div class=\"login-error\" id=\"loginError\"></div>\r\n\r\n      <form id=\"loginForm\" autocomplete=\"on\">\r\n        <div class=\"field\">\r\n          <label for=\"loginMobile\">Mobile number</label>\r\n          <input type=\"tel\" id=\"loginMobile\" name=\"mobile\" placeholder=\"9999999999\" autocomplete=\"username\" required pattern=\"[0-9]{10}\" maxlength=\"10\" inputmode=\"numeric\">\r\n        </div>\r\n        <div class=\"field\">\r\n          <label for=\"loginPassword\">Password</label>\r\n          <div class=\"pw-row\">\r\n            <input type=\"password\" id=\"loginPassword\" name=\"password\" placeholder=\"••••••••\" autocomplete=\"current-password\" required>\r\n            <button type=\"button\" class=\"pw-toggle\" id=\"pwToggle\">SHOW</button>\r\n          </div>\r\n        </div>\r\n        <button type=\"submit\" class=\"btn btn-primary btn-block\" id=\"loginBtn\">\r\n          <span id=\"loginBtnText\">Sign in</span>\r\n        </button>\r\n      </form>\r\n    <div class=\"api-base-note\">\r\n      <span>Contact</span>\r\n      <code>\r\n      Tejas Gund - +91 8177809890\r\n    </code>\r\n  </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ============================================================\r\n       ADMIN APP SHELL\r\n       ============================================================ -->\r\n  <div class=\"sidebar-scrim\" id=\"sidebarScrim\"></div>\r\n  <div class=\"app\" id=\"adminApp\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n      <div class=\"sidebar-mark\">\r\n        <div class=\"stamp-mark\">S</div>\r\n        <div class=\"wordmark\">Sahyadri Buisness Park<span>.</span></div>\r\n      </div>\r\n\r\n      <nav>\r\n        <div class=\"nav-group\">\r\n          <button class=\"nav-item active\" data-view=\"dashboard\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg>\r\n            Dashboard\r\n          </button>\r\n        </div>\r\n        <div class=\"nav-group\">\r\n          <div class=\"nav-label\">Property</div>\r\n          <button class=\"nav-item\" data-view=\"complexes\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 21h18M5 21V7l7-4 7 4v14M9 9h1m4 0h1m-5 4h1m4 0h1m-5 4h1m4 0h1\"/></svg>\r\n            Complexes\r\n          </button>\r\n          <button class=\"nav-item\" data-view=\"shops\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l1-5h16l1 5M4 9v10a1 1 0 001 1h14a1 1 0 001-1V9M4 9h16M9 21v-5a1 1 0 011-1h4a1 1 0 011 1v5\"/></svg>\r\n            Shops\r\n          </button>\r\n        </div>\r\n        <div class=\"nav-group\">\r\n          <div class=\"nav-label\">People</div>\r\n          <button class=\"nav-item\" data-view=\"users\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M2 21v-2a4 4 0 014-4h6a4 4 0 014 4v2M17 7a4 4 0 010 8M23 21v-2a4 4 0 00-3-3.87\"/></svg>\r\n            Users\r\n          </button>\r\n        </div>\r\n        <div class=\"nav-group\">\r\n          <div class=\"nav-label\">Finance</div>\r\n          <button class=\"nav-item\" data-view=\"bills\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 2h13l3 3v17H4z\"/><path d=\"M9 7h6M9 11h6M9 15h4\"/></svg>\r\n            Bills\r\n            <span class=\"nav-badge\" id=\"pendingBadge\" style=\"display:none;\">0</span>\r\n          </button>\r\n          <button class=\"nav-item\" data-view=\"payments\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"/></svg>\r\n            Payments\r\n          </button>\r\n          <button class=\"nav-item\" data-view=\"finance\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6\"/></svg>\r\n            Tenant View\r\n          </button>\r\n          <button class=\"nav-item\" data-view=\"deposits\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/></svg>\r\n            Deposits\r\n          </button>\r\n        </div>\r\n        <div class=\"nav-group\">\r\n          <div class=\"nav-label\">Insights</div>\r\n          <button class=\"nav-item\" data-view=\"reports\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 3v18h18\"/><path d=\"M18 9l-5 5-3-3-4 4\"/></svg>\r\n            Reports\r\n          </button>\r\n\r\n          <button class=\"nav-item\" data-view=\"ledger\">\r\n      <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\r\n      <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"2\"/>\r\n      <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"22\"/>\r\n      <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"22\"/>\r\n      <line x1=\"2\" y1=\"8\" x2=\"22\" y2=\"8\"/>\r\n        <line x1=\"2\" y1=\"16\" x2=\"22\" y2=\"16\"/>\r\n        </svg>\r\n          Ledger\r\n          </button>\r\n          <button class=\"nav-item\" data-view=\"scheduler\">\r\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\r\n            Scheduler\r\n          </button>\r\n        </div>\r\n      </nav>\r\n\r\n      <div class=\"sidebar-foot\">\r\n        <div class=\"user-chip\">\r\n          <div class=\"user-avatar\" id=\"sidebarAvatar\">A</div>\r\n          <div class=\"user-meta\">\r\n            <div class=\"name\" id=\"sidebarUserName\">Admin</div>\r\n            <div class=\"role\" id=\"sidebarUserRole\">admin</div>\r\n          </div>\r\n        </div>\r\n        <button class=\"logout-btn\" id=\"logoutBtn\">\r\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9\"/></svg>\r\n          Sign out\r\n        </button>\r\n      </div>\r\n    </aside>\r\n\r\n    <main class=\"main\">\r\n      <div class=\"topbar\">\r\n        <div style=\"display:flex; align-items:center; gap:10px;\">\r\n          <button class=\"menu-toggle\" id=\"menuToggle\" aria-label=\"Open menu\">\r\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/></svg>\r\n          </button>\r\n          <div>\r\n            <h2 id=\"viewTitle\">Dashboard</h2>\r\n            <div class=\"crumb\" id=\"viewCrumb\">Overview of your portfolio</div>\r\n          </div>\r\n        </div>\r\n        <div class=\"topbar-actions\">\r\n          <div style=\"position:relative;\">\r\n            <input class=\"search-input\" id=\"globalSearch\" placeholder=\"Search users, shops…\" style=\"min-width:200px; max-width:240px; padding-right:36px;\" autocomplete=\"off\">\r\n            <div id=\"globalSearchResults\" style=\"display:none; position:absolute; top:calc(100% + 6px); right:0; width:320px; background:var(--paper-raised); border:1.5px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow-lg); z-index:100; max-height:340px; overflow-y:auto;\"></div>\r\n          </div>\r\n          <button class=\"btn-icon\" id=\"refreshBtn\" title=\"Refresh data\" aria-label=\"Refresh data\">\r\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M23 4v6h-6M1 20v-6h6\"/><path d=\"M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15\"/></svg>\r\n          </button>\r\n          <button class=\"btn btn-primary btn-sm\" id=\"primaryActionBtn\">+ Add</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"content\" id=\"viewContent\">\r\n        <!-- views render here -->\r\n      </div>\r\n    </main>\r\n  </div>\r\n\r\n  <!-- ============================================================\r\n       TENANT PORTAL SHELL\r\n       ============================================================ -->\r\n  <div class=\"app\" id=\"tenantApp\">\r\n    <div class=\"tenant-shell\">\r\n      <div class=\"tenant-topbar\">\r\n        <div style=\"display:flex; align-items:center; gap:10px;\">\r\n        <div class=\"stamp-mark\" style=\"background:var(--green);\">Welcome</div>\r\n          <div>\r\n            <div style=\"font-weight:600; font-size:14.5px;\" id=\"tenantName\">—</div>\r\n          <div style=\"font-size:11.5px; color:#9FAA9A;\" id=\"tenantGreeting\">Loading…</div>\r\n          </div>\r\n        </div>\r\n        <div style=\"display:flex; gap:8px;\">\r\n          <button class=\"btn-icon\" id=\"tenantRefreshBtn\" style=\"border-color:rgba(255,255,255,0.2); color:#fff;\" title=\"Refresh\" aria-label=\"Refresh data\">\r\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M23 4v6h-6M1 20v-6h6\"/><path d=\"M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15\"/></svg>\r\n          </button>\r\n          <button class=\"logout-btn\" id=\"tenantLogoutBtn\" style=\"width:auto; margin-top:0;\">Sign out</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"tenant-content\" id=\"tenantContent\">\r\n        <!-- tenant views render here -->\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"toast-stack\" id=\"toastStack\"></div>\r\n\r\n  <!-- Modal -->\r\n  <div class=\"modal-overlay\" id=\"modalOverlay\">\r\n    <div class=\"modal\" id=\"modalEl\" role=\"dialog\" aria-modal=\"true\">\r\n      <div class=\"modal-head\">\r\n        <h3 id=\"modalTitle\">Title</h3>\r\n        <button class=\"modal-close\" id=\"modalCloseBtn\" aria-label=\"Close\">\r\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg>\r\n        </button>\r\n      </div>\r\n      <div class=\"modal-body\" id=\"modalBody\"></div>\r\n      <div class=\"modal-foot\" id=\"modalFoot\"></div>\r\n    </div>\r\n  </div>\r\n\r\n  <script>\r\n  /* ================================================================\r\n     CONFIG — set your backend URL here\r\n     ================================================================ */\r\n  const API_BASE_URL = \"http://13.205.70.46:8000\";\r\n\r\n  /* ================================================================\r\n     STATE\r\n     ================================================================ */\r\n  const state = {\r\n    token: localStorage.getItem('tms_token') || null,\r\n    role: localStorage.getItem('tms_role') || null,\r\n    currentUser: null,\r\n    view: 'dashboard',\r\n    cache: { complexes: [], shops: [], users: [], bills: [], payments: [] },\r\n    loaded: { complexes:false, shops:false, users:false, bills:false, payments:false },\r\n  };\r\n  // Set by dashboard \"at a glance\" cards to auto-apply a filter when the Bills view loads next.\r\n  let pendingBillsViewFilter = null;\r\n  let tpBillsData = [], tpShopsData = [], tpBillDrill = { year:null, month:null };\r\n  let tpPaysData = [], tpPayDrill = { year:null, month:null };\r\n\r\n  const apiDisplay = document.getElementById('apiBaseDisplay');\r\n  if (apiDisplay) {\r\n    apiDisplay.textContent = API_BASE_URL;\r\n  } else {\r\n    console.warn('⚠\uFE0F Element #apiBaseDisplay not found – login may fail.');\r\n  }\r\n\r\n  /* ================================================================\r\n     API LAYER\r\n     ================================================================ */\r\n  class ApiError extends Error {\r\n    constructor(message, status){ super(message); this.status = status; }\r\n  }\r\n\r\n  async function api(path, { method = 'GET', body = null, auth = true } = {}) {\r\n    const headers = { 'Content-Type': 'application/json' };\r\n    if (auth && state.token) headers['Authorization'] = `Bearer ${state.token}`;\r\n\r\n    let res;\r\n    try {\r\n      res = await fetch(`${API_BASE_URL}${path}`, {\r\n        method,\r\n        headers,\r\n        body: body ? JSON.stringify(body) : undefined,\r\n      });\r\n    } catch (err) {\r\n      throw new ApiError(`Can't reach the server at ${API_BASE_URL}. Check the API_BASE_URL value and that the backend is running.`, 0);\r\n    }\r\n\r\n    let data = null;\r\n    const text = await res.text();\r\n    if (text) {\r\n      try { data = JSON.parse(text); } catch { data = null; }\r\n    }\r\n\r\n    if (!res.ok) {\r\n      let msg = `Request failed (${res.status})`;\r\n      if (data) {\r\n        if (typeof data.detail === 'string') msg = data.detail;\r\n        else if (Array.isArray(data.detail)) msg = data.detail.map(d => d.msg).join(', ');\r\n      }\r\n      if (res.status === 401) { handleAuthExpired(); }\r\n      throw new ApiError(msg, res.status);\r\n    }\r\n    return data;\r\n  }\r\n\r\n  function handleAuthExpired(){\r\n    showToast('Your session expired. Please sign in again.', 'error');\r\n    logout();\r\n  }\r\n\r\n  /* ================================================================\r\n     TOASTS\r\n     ================================================================ */\r\n  function showToast(message, type = 'default'){\r\n    const stack = document.getElementById('toastStack');\r\n    const el = document.createElement('div');\r\n    el.className = `toast ${type}`;\r\n    const icon = type === 'success'\r\n      ? '<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>'\r\n      : type === 'error'\r\n        ? '<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>'\r\n        : '';\r\n    el.innerHTML = `${icon}<span>${escapeHtml(message)}</span>`;\r\n    stack.appendChild(el);\r\n    setTimeout(() => {\r\n      el.classList.add('fade-out');\r\n      setTimeout(() => el.remove(), 250);\r\n    }, 3400);\r\n  }\r\n\r\n  function escapeHtml(str){\r\n    const d = document.createElement('div');\r\n    d.textContent = String(str ?? '');\r\n    return d.innerHTML;\r\n  }\r\n\r\n  /* ================================================================\r\n     FORMATTERS\r\n     ================================================================ */\r\n  const currency = (n) => '₹' + Number(n ?? 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\r\n  const dateFmt = (iso) => {\r\n    if (!iso) return '—';\r\n    const d = new Date(iso);\r\n    if (isNaN(d)) return iso;\r\n    return d.toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' });\r\n  };\r\n  const initials = (name) => (name || '?').trim().split(/\\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase();\r\n\r\n  function daysLeftHtml(endIso){\r\n    if (!endIso) return '<span style=\"color:var(--muted);\">—</span>';\r\n    const end = new Date(endIso);\r\n    if (isNaN(end)) return '<span style=\"color:var(--muted);\">—</span>';\r\n    const today = new Date();\r\n    today.setHours(0,0,0,0);\r\n    end.setHours(0,0,0,0);\r\n    const days = Math.round((end - today) / 86400000);\r\n    if (days < 0) return `<span style=\"color:var(--rust); font-weight:700;\">Expired ${Math.abs(days)}d ago</span>`;\r\n    if (days === 0) return `<span style=\"color:var(--rust); font-weight:700;\">Expires today</span>`;\r\n    if (days <= 30) return `<span style=\"color:var(--rust); font-weight:600;\">${days}d left</span>`;\r\n    if (days <= 90) return `<span style=\"color:#b8860b; font-weight:600;\">${days}d left</span>`;\r\n    return `<span style=\"color:var(--success);\">${days}d left</span>`;\r\n  }\r\n\r\n\r\n\r\n\r\n  /* ================================================================\r\n     TENANT GREETING HELPER\r\n     ================================================================ */\r\n  function getTimeGreeting(name){\r\n    const hour = new Date().getHours();\r\n    let timePhrase = '';\r\n    if (hour < 12) timePhrase = 'Good morning';\r\n    else if (hour < 17) timePhrase = 'Good afternoon';\r\n    else timePhrase = 'Good evening';\r\n\r\n    const creativeMessages = [\r\n      `${timePhrase}, ${name}! ✨`,\r\n      `${timePhrase}, ${name} – your shops are ready!`,\r\n      `${timePhrase}, ${name}! Let's get things done!`,\r\n      `${timePhrase}, ${name} – we're all set for you.`,\r\n      `${timePhrase}, ${name}! How can I help you today?`,\r\n    ];\r\n    return creativeMessages[Math.floor(Math.random() * creativeMessages.length)];\r\n  }\r\n\r\n\r\n\r\n  /* ================================================================\r\n     AUTH\r\n     ================================================================ */\r\n  const loginScreen = document.getElementById('loginScreen');\r\n  const adminApp = document.getElementById('adminApp');\r\n  const tenantApp = document.getElementById('tenantApp');\r\n  const loginForm = document.getElementById('loginForm');\r\n  const loginError = document.getElementById('loginError');\r\n  const loginBtn = document.getElementById('loginBtn');\r\n  const loginBtnText = document.getElementById('loginBtnText');\r\n\r\n  document.getElementById('pwToggle').addEventListener('click', () => {\r\n    const pw = document.getElementById('loginPassword');\r\n    const btn = document.getElementById('pwToggle');\r\n    if (pw.type === 'password'){ pw.type = 'text'; btn.textContent = 'HIDE'; }\r\n    else { pw.type = 'password'; btn.textContent = 'SHOW'; }\r\n  });\r\n\r\n  loginForm.addEventListener('submit', async (e) => {\r\n    e.preventDefault();\r\n    loginError.classList.remove('show');\r\n    const mobile = document.getElementById('loginMobile').value.trim();\r\n    const password = document.getElementById('loginPassword').value;\r\n\r\n    loginBtn.disabled = true;\r\n    loginBtnText.innerHTML = '<span class=\"spinner\"></span>';\r\n\r\n    try {\r\n      const data = await api('/api/login', { method:'POST', body:{ mobile, password }, auth:false });\r\n      state.token = data.token;\r\n      state.role = data.role;\r\n      localStorage.setItem('tms_token', data.token);\r\n      localStorage.setItem('tms_role', data.role);\r\n      await bootAfterLogin();\r\n    } catch (err) {\r\n      loginError.textContent = err.message || 'Sign in failed. Check your credentials.';\r\n      loginError.classList.add('show');\r\n    } finally {\r\n      loginBtn.disabled = false;\r\n      loginBtnText.textContent = 'Sign in';\r\n    }\r\n  });\r\n\r\n  function logout(){\r\n    state.token = null; state.role = null; state.currentUser = null;\r\n    localStorage.removeItem('tms_token'); localStorage.removeItem('tms_role');\r\n    adminApp.classList.remove('show');\r\n    tenantApp.classList.remove('show');\r\n    loginScreen.style.display = 'flex';\r\n    loginForm.reset();\r\n  }\r\n\r\n  document.getElementById('logoutBtn').addEventListener('click', logout);\r\n  document.getElementById('tenantLogoutBtn').addEventListener('click', logout);\r\n\r\n  async function bootAfterLogin(){\r\n    if (state.role === 'admin'){\r\n      loginScreen.style.display = 'none';\r\n      adminApp.classList.add('show');\r\n      await initAdminUser();\r\n      navigateTo('dashboard');\r\n    } else {\r\n      loginScreen.style.display = 'none';\r\n      tenantApp.classList.add('show');\r\n      await loadTenantPortal();\r\n    }\r\n  }\r\n\r\n  async function initAdminUser(){\r\n    try {\r\n      const users = await api('/api/user');\r\n      state.cache.users = users; state.loaded.users = true;\r\n      document.getElementById('sidebarUserName').textContent = 'Admin';\r\n      document.getElementById('sidebarUserRole').textContent = state.role;\r\n      document.getElementById('sidebarAvatar').textContent = 'A';\r\n    } catch (err) { /* non-fatal */ }\r\n  }\r\n\r\n  // Try silent resume on load\r\n  (async function tryResume(){\r\n    if (state.token && state.role){\r\n      try { await bootAfterLogin(); }\r\n      catch(err){ logout(); }\r\n    }\r\n  })();\r\n\r\n  /* ================================================================\r\n     ADMIN NAV / VIEW ROUTING\r\n     ================================================================ */\r\n  const sidebar = document.getElementById('sidebar');\r\n  const sidebarScrim = document.getElementById('sidebarScrim');\r\n  document.getElementById('menuToggle').addEventListener('click', () => {\r\n    sidebar.classList.add('open'); sidebarScrim.classList.add('show');\r\n  });\r\n  sidebarScrim.addEventListener('click', closeSidebar);\r\n  function closeSidebar(){ sidebar.classList.remove('open'); sidebarScrim.classList.remove('show'); }\r\n\r\n  const viewMeta = {\r\n    dashboard: { title:'Dashboard', crumb:'Overview of your portfolio', action:null },\r\n    complexes: { title:'Complexes', crumb:'Buildings and properties you manage', action:'Add complex' },\r\n    shops:     { title:'Shops', crumb:'Units across all complexes', action:'Add shop' },\r\n    users:     { title:'Users', crumb:'Admins and tenants', action:'Add user' },\r\n    bills:     { title:'Bills', crumb:'Charges raised to tenants', action:'Create bills' },\r\n    payments:  { title:'Payments', crumb:'Payments recorded against bills', action:'Record payment' },\r\n    finance:   { title:'Tenant View', crumb:'Full tenant dashboard – bills, payments, deposit status', action:null },\r\n    deposits:  { title:'Deposit Payments', crumb:'Security deposit collection tracking', action:'Record deposit' },\r\n    reports:   { title:'Reports', crumb:'Occupancy, collections and outstanding dues', action:null },\r\n    ledger: { title:'Month-wise Ledger', crumb:'Monthly breakdown of bills, payments, and deposits', action:null },\r\n    scheduler: { title:'Scheduler', crumb:'Rent-billing job configuration', action:null },\r\n  };\r\n\r\n  document.querySelectorAll('.nav-item[data-view]').forEach(btn => {\r\n    btn.addEventListener('click', () => { navigateTo(btn.dataset.view); closeSidebar(); });\r\n  });\r\n\r\n  async function navigateTo(view){\r\n    state.view = view;\r\n    document.querySelectorAll('.nav-item[data-view]').forEach(b => b.classList.toggle('active', b.dataset.view === view));\r\n    const meta = viewMeta[view];\r\n    document.getElementById('viewTitle').textContent = meta.title;\r\n    document.getElementById('viewCrumb').textContent = meta.crumb;\r\n    const actionBtn = document.getElementById('primaryActionBtn');\r\n    if (meta.action){ actionBtn.style.display = 'inline-flex'; actionBtn.textContent = '+ ' + meta.action.replace(/^Add /,'').replace(/^Record /,''); }\r\n    else { actionBtn.style.display = 'none'; }\r\n    await renderView(view);\r\n  }\r\n\r\n  document.getElementById('refreshBtn').addEventListener('click', () => refreshCurrentView(true));\r\n  document.getElementById('primaryActionBtn').addEventListener('click', () => {\r\n    if (state.view === 'deposits') openDepositModal();\r\n    else openCreateModal(state.view);\r\n  });\r\n\r\n  async function refreshCurrentView(showSpinner){\r\n    const btn = document.getElementById('refreshBtn');\r\n    if (showSpinner) btn.classList.add('spinning');\r\n    Object.keys(state.loaded).forEach(k => state.loaded[k] = false);\r\n    try { await renderView(state.view); showToast('Data refreshed', 'success'); }\r\n    finally { btn.classList.remove('spinning'); }\r\n  }\r\n\r\n  async function renderView(view){\r\n    const content = document.getElementById('viewContent');\r\n    content.innerHTML = skeletonHtml();\r\n    try {\r\n      switch(view){\r\n        case 'dashboard': content.innerHTML = await dashboardView(); attachDashboardHandlers(); break;\r\n        case 'complexes': content.innerHTML = await complexesView(); attachComplexHandlers(); break;\r\n        case 'shops': content.innerHTML = await shopsView(); attachShopHandlers(); break;\r\n        case 'users': content.innerHTML = await usersView(); attachUserHandlers(); break;\r\n        case 'bills': content.innerHTML = await billsView(); attachBillHandlers(); break;\r\n        case 'payments': content.innerHTML = await paymentsView(); attachPaymentHandlers(); break;\r\n        case 'finance': content.innerHTML = await financeView(); attachFinanceHandlers(); break;\r\n        case 'deposits': content.innerHTML = await depositsView(); attachDepositHandlers(); break;\r\n        case 'reports': content.innerHTML = await reportsView(); attachReportsHandlers(); break;\r\n        case 'ledger': content.innerHTML = await ledgerView(); attachLedgerHandlers(); break;\r\n        case 'scheduler': content.innerHTML = await schedulerView(); attachSchedulerHandlers(); break;\r\n      }\r\n      attachSearchFilter();\r\n    } catch (err) {\r\n      content.innerHTML = errorBannerHtml(err.message);\r\n      document.getElementById('retryBtn')?.addEventListener('click', () => renderView(view));\r\n    }\r\n  }\r\n\r\n  function skeletonHtml(){\r\n    return `<div class=\"table-wrap\">${Array.from({length:5}).map(()=>'<div class=\"skeleton-row\"></div>').join('')}</div>`;\r\n  }\r\n  function errorBannerHtml(msg){\r\n    return `<div class=\"error-banner\">\r\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>\r\n      <span>${escapeHtml(msg)}</span>\r\n      <button id=\"retryBtn\" class=\"btn btn-sm btn-ghost\" style=\"margin-left:auto; border-color:var(--danger); color:var(--danger);\">Retry</button>\r\n    </div>`;\r\n  }\r\n  function emptyStateHtml(title, sub, iconSvg){\r\n    return `<div class=\"empty-state\">${iconSvg}<h3>${escapeHtml(title)}</h3><p>${escapeHtml(sub)}</p></div>`;\r\n  }\r\n\r\n  async function ensureLoaded(key, path){\r\n    if (!state.loaded[key]){\r\n      state.cache[key] = await api(path);\r\n      state.loaded[key] = true;\r\n    }\r\n    return state.cache[key];\r\n  }\r\n\r\n  function attachSearchFilter(){\r\n    const input = document.getElementById('tableSearch');\r\n    if (!input) return;\r\n    input.addEventListener('input', () => {\r\n      const q = input.value.trim().toLowerCase();\r\n      document.querySelectorAll('tbody tr[data-search]').forEach(tr => {\r\n        tr.style.display = tr.dataset.search.toLowerCase().includes(q) ? '' : 'none';\r\n      });\r\n    });\r\n  }\r\n\r\n  /* ================================================================\r\n     DASHBOARD VIEW\r\n     ================================================================ */\r\n  async function dashboardView(){\r\n    const [complexes, shops, users, bills] = await Promise.all([\r\n      ensureLoaded('complexes','/api/complex'),\r\n      ensureLoaded('shops','/api/shop'),\r\n      ensureLoaded('users','/api/user'),\r\n      ensureLoaded('bills','/api/bill'),\r\n    ]);\r\n\r\n    const occupied = shops.filter(s => s.status === 'occupied').length;\r\n    const pendingBills = bills.filter(b => b.status !== 'paid');\r\n    const pendingTotal = pendingBills.reduce((sum,b) => sum + Number(b.pending_amount||0), 0);\r\n    const collectedTotal = bills.reduce((sum,b) => sum + Number(b.paid_amount||0), 0);\r\n    const totalMonthlyRent = shops.filter(s=>s.status==='occupied').reduce((sum,s)=>sum+Number(s.shop_rent||0),0);\r\n\r\n    updatePendingBadge(pendingBills.length);\r\n\r\n    const recentBills = [...bills].sort((a,b) => new Date(b.bill_date) - new Date(a.bill_date)).slice(0,6);\r\n\r\n    // Billing-at-a-glance breakdown (computed client-side from already-loaded bills — no extra API calls)\r\n    const now = new Date();\r\n    const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);\r\n    const monthEnd = new Date(now.getFullYear(), now.getMonth()+1, 0, 23, 59, 59);\r\n    const overdueBills = bills.filter(b => b.status !== 'paid' && b.due_date && new Date(b.due_date) < now);\r\n    const dueThisMonthBills = bills.filter(b => b.status !== 'paid' && b.due_date && new Date(b.due_date) >= monthStart && new Date(b.due_date) <= monthEnd);\r\n    const paidBills = bills.filter(b => b.status === 'paid');\r\n    const partialBills = bills.filter(b => b.status === 'partial');\r\n    const usersWithPending = new Set(pendingBills.map(b=>b.user_id)).size;\r\n\r\n    // Per-complex stats\r\n    const complexStats = complexes.map(c => {\r\n      const cShops = shops.filter(s => s.complex_id === c.id);\r\n      const cOccupied = cShops.filter(s => s.status === 'occupied');\r\n      const cAvailable = cShops.filter(s => s.status === 'available');\r\n      const cMonthlyRent = cOccupied.reduce((sum,s)=>sum+Number(s.shop_rent||0),0);\r\n      // pending rent = sum of pending_amount on bills for shops in this complex\r\n      const cShopIds = new Set(cShops.map(s=>s.id));\r\n      const cPending = bills.filter(b => cShopIds.has(b.shop_id) && b.status !== 'paid')\r\n                            .reduce((sum,b)=>sum+Number(b.pending_amount||0),0);\r\n      return { ...c, totalShops: cShops.length, occupiedShops: cOccupied.length, availableShops: cAvailable.length, monthlyRent: cMonthlyRent, pendingRent: cPending };\r\n    });\r\n\r\n    return `\r\n    <div class=\"stat-row\">\r\n      <div class=\"card stat-card\"><div class=\"label\">Complexes</div><div class=\"value\">${complexes.length}</div><div class=\"sub\">properties managed</div></div>\r\n      <div class=\"card stat-card\"><div class=\"label\">Shops</div><div class=\"value\">${shops.length}</div><div class=\"sub\">${occupied} occupied · ${shops.length-occupied} available</div></div>\r\n      <div class=\"card stat-card\"><div class=\"label\">Tenants</div><div class=\"value\">${users.filter(u=>u.role==='tenant').length}</div><div class=\"sub\">${users.length} total users</div></div>\r\n      <div class=\"card stat-card accent-green\"><div class=\"label\">Monthly rent</div><div class=\"value mono\">${currency(totalMonthlyRent)}</div><div class=\"sub\">from occupied shops</div></div>\r\n      <div class=\"card stat-card accent-rust\"><div class=\"label\">Pending dues</div><div class=\"value mono\">${currency(pendingTotal)}</div><div class=\"sub\">${pendingBills.length} bills outstanding</div></div>\r\n      <div class=\"card stat-card accent-green\"><div class=\"label\">Collected</div><div class=\"value mono\">${currency(collectedTotal)}</div><div class=\"sub\">across all bills</div></div>\r\n    </div>\r\n\r\n    <h3 style=\"font-size:15.5px; margin:0 0 14px;\">Billing at a glance</h3>\r\n    <div class=\"glance-grid\" style=\"display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:12px; margin-bottom:24px;\">\r\n      <button type=\"button\" class=\"card stat-card glance-card\" data-glance=\"overdue\" style=\"text-align:left; cursor:pointer;\">\r\n        <div class=\"label\">Overdue</div><div class=\"value mono\" style=\"color:var(--danger); font-size:22px;\">${overdueBills.length}</div><div class=\"sub\">${currency(overdueBills.reduce((s,b)=>s+Number(b.pending_amount||0),0))} at risk</div>\r\n      </button>\r\n      <button type=\"button\" class=\"card stat-card glance-card\" data-glance=\"due-this-month\" style=\"text-align:left; cursor:pointer;\">\r\n        <div class=\"label\">Due this month</div><div class=\"value mono\" style=\"font-size:22px;\">${dueThisMonthBills.length}</div><div class=\"sub\">${currency(dueThisMonthBills.reduce((s,b)=>s+Number(b.pending_amount||0),0))} expected</div>\r\n      </button>\r\n      <button type=\"button\" class=\"card stat-card glance-card\" data-glance=\"partial\" style=\"text-align:left; cursor:pointer;\">\r\n        <div class=\"label\">Partially paid</div><div class=\"value mono\" style=\"color:var(--partial); font-size:22px;\">${partialBills.length}</div><div class=\"sub\">in progress</div>\r\n      </button>\r\n      <button type=\"button\" class=\"card stat-card glance-card\" data-glance=\"paid\" style=\"text-align:left; cursor:pointer;\">\r\n        <div class=\"label\">Paid</div><div class=\"value mono\" style=\"color:var(--success); font-size:22px;\">${paidBills.length}</div><div class=\"sub\">settled in full</div>\r\n      </button>\r\n      <button type=\"button\" class=\"card stat-card glance-card\" data-glance=\"outstanding\" style=\"text-align:left; cursor:pointer;\">\r\n        <div class=\"label\">Tenants with dues</div><div class=\"value mono\" style=\"font-size:22px;\">${usersWithPending}</div><div class=\"sub\">of ${users.filter(u=>u.role==='tenant').length} tenants</div>\r\n      </button>\r\n    </div>\r\n\r\n    ${complexStats.length > 0 ? `\r\n    <h3 style=\"font-size:15.5px; margin:0 0 14px;\">Complex overview</h3>\r\n    <div style=\"display:grid; grid-template-columns:repeat(auto-fill, minmax(300px,1fr)); gap:14px; margin-bottom:24px;\">\r\n      ${complexStats.map(c=>`\r\n      <div class=\"complex-stat-card\">\r\n        <div class=\"c-name\">\r\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 21h18M5 21V7l7-4 7 4v14\"/></svg>\r\n          ${escapeHtml(c.name)}\r\n        </div>\r\n        <div class=\"complex-stat-grid\">\r\n          <div class=\"complex-stat-item\"><div class=\"csi-val\">${c.totalShops}</div><div class=\"csi-label\">Total</div></div>\r\n          <div class=\"complex-stat-item accent-green\"><div class=\"csi-val\">${c.occupiedShops}</div><div class=\"csi-label\">Occupied</div></div>\r\n          <div class=\"complex-stat-item\"><div class=\"csi-val\">${c.availableShops}</div><div class=\"csi-label\">Available</div></div>\r\n        </div>\r\n        <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; padding-top:10px; border-top:1px dashed var(--line);\">\r\n          <div><div style=\"font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; font-weight:600;\">Monthly Rent</div><div style=\"font-family:var(--font-mono); font-weight:700; color:var(--green-deep); font-size:14px;\">${currency(c.monthlyRent)}</div></div>\r\n          <div><div style=\"font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; font-weight:600;\">Pending Rent</div><div style=\"font-family:var(--font-mono); font-weight:700; color:${c.pendingRent>0?'var(--rust)':'var(--success)'}; font-size:14px;\">${currency(c.pendingRent)}</div></div>\r\n        </div>\r\n      </div>`).join('')}\r\n    </div>` : ''}\r\n\r\n    <div class=\"card\">\r\n      <div class=\"card-pad\" style=\"padding-bottom:0;\"><h3 style=\"font-size:15.5px;\">Recent bills</h3></div>\r\n      ${recentBills.length === 0 ? emptyStateHtml('No bills yet', 'Bills you raise will show up here.', emptyIcon()) : `\r\n      <div class=\"table-wrap\" style=\"border:none; border-radius:0; box-shadow:none; margin-top:10px;\">\r\n        <table>\r\n          <thead><tr><th>Bill</th><th>Tenant</th><th>Type</th><th class=\"num\">Amount</th><th>Status</th><th>Due</th></tr></thead>\r\n          <tbody>\r\n            ${recentBills.map(b => {\r\n              const tenant = state.cache.users.find(u=>u.id===b.user_id);\r\n              return `<tr>\r\n                <td class=\"mono\">#${b.id}</td>\r\n                <td>${escapeHtml(tenant?.name || ('User #'+b.user_id))}</td>\r\n                <td>${escapeHtml(b.bill_type)}</td>\r\n                <td class=\"num\">${currency(b.amount)}</td>\r\n                <td>${stampHtml(b.status)}</td>\r\n                <td>${dateFmt(b.due_date)}</td>\r\n              </tr>`;\r\n            }).join('')}\r\n          </tbody>\r\n        </table>\r\n      </div>`}\r\n    </div>`;\r\n  }\r\n\r\n  function attachDashboardHandlers(){\r\n    document.querySelectorAll('.glance-card').forEach(card => {\r\n      card.addEventListener('click', () => {\r\n        pendingBillsViewFilter = card.dataset.glance;\r\n        navigateTo('bills');\r\n      });\r\n    });\r\n  }\r\n\r\n  function updatePendingBadge(count){\r\n    const badge = document.getElementById('pendingBadge');\r\n    if (count > 0){ badge.style.display='inline-block'; badge.textContent = count; }\r\n    else badge.style.display = 'none';\r\n  }\r\n\r\n  function stampHtml(status){\r\n    const cls = status === 'paid' ? 'paid' : status === 'partial' ? 'partial' : 'pending';\r\n    return `<span class=\"stamp ${cls}\">${escapeHtml(status)}</span>`;\r\n  }\r\n  function emptyIcon(){\r\n    return `<svg width=\"42\" height=\"42\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"/><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"/></svg>`;\r\n  }\r\n  function warnIcon(){\r\n    return `<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg>`;\r\n  }\r\n\r\n  /* ================================================================\r\n     COMPLEXES VIEW\r\n     ================================================================ */\r\n  async function complexesView(){\r\n    const complexes = await ensureLoaded('complexes','/api/complex');\r\n    return `\r\n    <div class=\"toolbar\"><input class=\"search-input\" id=\"tableSearch\" placeholder=\"Search complexes…\"></div>\r\n    ${complexes.length === 0 ? emptyStateHtml('No complexes yet', 'Add your first complex to start assigning shops to it.', emptyIcon()) : `\r\n    <div class=\"table-wrap\">\r\n      <table>\r\n        <thead><tr><th>Name</th><th>Address</th><th>Description</th><th>Created</th><th></th></tr></thead>\r\n        <tbody>\r\n          ${complexes.map(c => `\r\n            <tr data-search=\"${escapeHtml(c.name+' '+c.address)}\">\r\n              <td><strong>${escapeHtml(c.name)}</strong></td>\r\n              <td>${escapeHtml(c.address)}</td>\r\n              <td>${escapeHtml(c.description || '—')}</td>\r\n              <td>${dateFmt(c.created_at)}</td>\r\n              <td><div class=\"row-actions\">\r\n                <button class=\"btn-icon\" data-edit-complex=\"${c.id}\" aria-label=\"Edit\">${editIcon()}</button>\r\n                <button class=\"btn-icon\" data-delete-complex=\"${c.id}\" data-name=\"${escapeHtml(c.name)}\" aria-label=\"Delete\">${trashIcon()}</button>\r\n              </div></td>\r\n            </tr>`).join('')}\r\n        </tbody>\r\n      </table>\r\n    </div>`}`;\r\n  }\r\n\r\n  function editIcon(){ return `<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7\"/><path d=\"M18.5 2.5a2.12 2.12 0 013 3L12 15l-4 1 1-4 9.5-9.5z\"/></svg>`; }\r\n  function trashIcon(){ return `<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"3 6 5 6 21 6\"/><path d=\"M19 6l-1.5 14.5a2 2 0 01-2 1.5H8.5a2 2 0 01-2-1.5L5 6m5 0V4a1 1 0 011-1h2a1 1 0 011 1v2\"/></svg>`; }\r\n\r\n  function attachComplexHandlers(){\r\n    document.querySelectorAll('[data-edit-complex]').forEach(btn => btn.addEventListener('click', () => openEditComplexModal(Number(btn.dataset.editComplex))));\r\n    document.querySelectorAll('[data-delete-complex]').forEach(btn => btn.addEventListener('click', () => confirmDelete('complex', Number(btn.dataset.deleteComplex), btn.dataset.name)));\r\n  }\r\n\r\n  /* ================================================================\r\n     SHOPS VIEW\r\n     ================================================================ */\r\n  async function shopsView(){\r\n    const [shops, complexes] = await Promise.all([ensureLoaded('shops','/api/shop'), ensureLoaded('complexes','/api/complex')]);\r\n    const complexName = (id) => complexes.find(c=>c.id===id)?.name || `#${id}`;\r\n    const availableCount = shops.filter(s=>s.status==='available').length;\r\n    const occupiedCount = shops.filter(s=>s.status==='occupied').length;\r\n\r\n    return `\r\n    <div class=\"toolbar\">\r\n      <input class=\"search-input\" id=\"tableSearch\" placeholder=\"Search shops…\">\r\n      <div class=\"filter-chips\" id=\"shopFilterChips\">\r\n        <button class=\"chip active\" data-filter=\"all\">All (${shops.length})</button>\r\n        <button class=\"chip\" data-filter=\"available\">Empty (${availableCount})</button>\r\n        <button class=\"chip\" data-filter=\"occupied\">Occupied (${occupiedCount})</button>\r\n      </div>\r\n    </div>\r\n    ${shops.length === 0 ? emptyStateHtml('No shops yet', 'Add a shop and assign it to a complex.', emptyIcon()) : `\r\n    <div class=\"table-wrap\">\r\n      <table>\r\n        <thead><tr><th>Shop #</th><th>Complex</th><th class=\"num\">Area (sqft)</th><th class=\"num\">Rent/mo</th><th class=\"num\">Deposit</th><th>Status</th><th>Tenant</th><th></th></tr></thead>\r\n        <tbody>\r\n          ${shops.map(s => `\r\n            <tr data-search=\"${escapeHtml(s.shop_number+' '+complexName(s.complex_id)+' '+(s.assigned_to?.name||''))}\" data-status=\"${s.status}\">\r\n              <td class=\"mono\"><strong>${escapeHtml(s.shop_number)}</strong></td>\r\n              <td>${escapeHtml(complexName(s.complex_id))}</td>\r\n              <td class=\"num\">${Number(s.area_sqft).toLocaleString('en-IN')}</td>\r\n              <td class=\"num\">${s.shop_rent != null ? currency(s.shop_rent) : '—'}</td>\r\n              <td class=\"num\">${s.shop_deposit != null ? currency(s.shop_deposit) : '—'}</td>\r\n              <td><span class=\"pill ${s.status}\"><span class=\"pill-dot\"></span>${escapeHtml(s.status)}</span></td>\r\n              <td>${s.assigned_to ? `<span class=\"tenant-tag\">${escapeHtml(s.assigned_to.name)}</span>` : '<span style=\"color:var(--muted); font-size:13px;\">— empty —</span>'}</td>\r\n              <td><div class=\"row-actions\">\r\n                ${s.assigned_to ? `<button class=\"btn-icon\" data-deassign-shop=\"${s.id}\" data-shopnum=\"${escapeHtml(s.shop_number)}\" data-tenant=\"${escapeHtml(s.assigned_to.name)}\" data-userid=\"${s.assigned_to.id}\" aria-label=\"Deassign tenant\" title=\"Deassign tenant\">${unlinkIcon()}</button>` : ''}\r\n                <button class=\"btn-icon\" data-edit-shop=\"${s.id}\" aria-label=\"Edit\">${editIcon()}</button>\r\n                <button class=\"btn-icon\" data-delete-shop=\"${s.id}\" data-name=\"${escapeHtml(s.shop_number)}\" aria-label=\"Delete\">${trashIcon()}</button>\r\n              </div></td>\r\n            </tr>`).join('')}\r\n        </tbody>\r\n      </table>\r\n    </div>`}`;\r\n  }\r\n  function unlinkIcon(){ return `<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18.84 12.25l1.72-1.71a5 5 0 00-7.07-7.07l-1.05 1.05M5.17 11.75l-1.71 1.71a5 5 0 007.07 7.07l1.05-1.05M8 12h8\"/></svg>`; }\r\n\r\n  function attachShopHandlers(){\r\n    document.querySelectorAll('[data-edit-shop]').forEach(btn => btn.addEventListener('click', () => openEditShopModal(Number(btn.dataset.editShop))));\r\n    document.querySelectorAll('[data-delete-shop]').forEach(btn => btn.addEventListener('click', () => confirmDelete('shop', Number(btn.dataset.deleteShop), btn.dataset.name)));\r\n    document.querySelectorAll('[data-deassign-shop]').forEach(btn => btn.addEventListener('click', () => confirmDeassignShop(\r\n      Number(btn.dataset.deassignShop), btn.dataset.shopnum, btn.dataset.tenant, Number(btn.dataset.userid)\r\n    )));\r\n    const chips = document.querySelectorAll('#shopFilterChips .chip');\r\n    chips.forEach(chip => chip.addEventListener('click', () => {\r\n      chips.forEach(c => c.classList.remove('active'));\r\n      chip.classList.add('active');\r\n      const filter = chip.dataset.filter;\r\n      document.querySelectorAll('tbody tr[data-status]').forEach(tr => {\r\n        tr.style.display = (filter === 'all' || tr.dataset.status === filter) ? '' : 'none';\r\n      });\r\n    }));\r\n  }\r\n\r\n  function confirmDeassignShop(shopId, shopNum, tenantName, userId){\r\n    openModal('Deassign tenant', `\r\n      <div class=\"confirm-body\">Remove <strong>${escapeHtml(tenantName)}</strong> from shop <strong>${escapeHtml(shopNum)}</strong>? The shop will become available for a new tenant.</div>\r\n    `, `\r\n      <button class=\"btn btn-ghost\" id=\"cancelBtn\">Cancel</button>\r\n      <button class=\"btn btn-danger-ghost\" id=\"confirmBtn\">Deassign</button>\r\n    `);\r\n    document.getElementById('cancelBtn').addEventListener('click', closeModal);\r\n    document.getElementById('confirmBtn').addEventListener('click', async () => {\r\n      await withSavingState('confirmBtn', async () => {\r\n        await api(`/api/user/${userId}/detach-shops`, { method:'POST', body:{ shop_ids:[shopId] } });\r\n        state.loaded.shops = false;\r\n        closeModal();\r\n        showToast(`${tenantName} removed from shop ${shopNum}`, 'success');\r\n        await renderView('shops');\r\n      }, 'Removing…');\r\n    });\r\n  }\r\n\r\n  /* ================================================================\r\n     USERS VIEW\r\n     ================================================================ */\r\n  async function usersView(){\r\n    const [users, shops] = await Promise.all([\r\n      ensureLoaded('users','/api/user'),\r\n      ensureLoaded('shops','/api/shop'),\r\n    ]);\r\n\r\n    // Calculate per-user summaries from shop data\r\n    const userShopSummary = (uid) => {\r\n      const owned = shops.filter(s => s.assigned_to?.id === uid);\r\n      const totalRent = owned.reduce((sum,s)=>sum+Number(s.shop_rent||0),0);\r\n      const totalDeposit = owned.reduce((sum,s)=>sum+Number(s.shop_deposit||0),0);\r\n      // Nearest-expiring agreement end date and earliest agreement start date across this tenant's shops\r\n      const endDates = owned.map(s => s.assigned_to?.agreement_end_date).filter(Boolean);\r\n      const nearestEnd = endDates.length\r\n        ? endDates.reduce((a,b) => new Date(a) < new Date(b) ? a : b)\r\n        : null;\r\n      const startDates = owned.map(s => s.assigned_to?.agreement_start_date).filter(Boolean);\r\n      const earliestStart = startDates.length\r\n        ? startDates.reduce((a,b) => new Date(a) < new Date(b) ? a : b)\r\n        : null;\r\n      const rentDays = owned.map(s => s.assigned_to?.rent_day).filter(d => d !== null && d !== undefined);\r\n      const uniqueRentDays = [...new Set(rentDays)];\r\n      const rentDay = uniqueRentDays.length === 1 ? uniqueRentDays[0] : (uniqueRentDays.length === 0 ? null : 'multiple');\r\n      const missingRentDay = owned.some(s => !s.assigned_to || s.assigned_to.rent_day === null || s.assigned_to.rent_day === undefined);\r\n      return { count: owned.length, totalRent, totalDeposit, nearestEnd, earliestStart, rentDay, missingRentDay };\r\n    };\r\n\r\n    return `\r\n    <div class=\"toolbar\"><input class=\"search-input\" id=\"tableSearch\" placeholder=\"Search users by name, mobile, email…\"></div>\r\n    ${users.length === 0 ? emptyStateHtml('No users yet', 'Add tenants or admins to get started.', emptyIcon()) : `\r\n    <div class=\"table-wrap\">\r\n      <table>\r\n  <thead><tr><th>Name</th><th>Mobile</th><th>Role</th><th>Status</th><th class=\"num\">Shops</th><th class=\"num\">Monthly Rent</th><th class=\"num\">Total Deposit</th><th>Agreement Start</th><th>Rent Day</th><th>Agreement End</th><th></th></tr></thead>\r\n        <tbody>\r\n          ${users.map(u => {\r\n            const summary = u.role === 'tenant' ? userShopSummary(u.id) : null;\r\n            return `\r\n            <tr data-search=\"${escapeHtml(u.name+' '+u.mobile+' '+(u.email||''))}\">\r\n              <td><strong>${escapeHtml(u.name)}</strong>${u.email ? `<div style=\"font-size:12px;color:var(--muted);\">${escapeHtml(u.email)}</div>` : ''}</td>\r\n              <td class=\"mono\">${escapeHtml(u.mobile)}</td>\r\n              <td><span class=\"pill role-${u.role}\"><span class=\"pill-dot\"></span>${escapeHtml(u.role)}</span></td>\r\n              <td><span class=\"pill ${u.is_active ? 'active-pill' : 'inactive-pill'}\"><span class=\"pill-dot\"></span>${u.is_active ? 'active' : 'inactive'}</span></td>\r\n              <td class=\"num\">${summary ? summary.count : '—'}</td>\r\n              <td class=\"num\">${summary ? currency(summary.totalRent) : '—'}</td>\r\n              <td class=\"num\">${summary ? currency(summary.totalDeposit) : '—'}</td>\r\n              <td>${summary ? dateFmt(summary.earliestStart) : '—'}</td>\r\n              <td>${summary ? (summary.rentDay === 'multiple' ? 'Multiple' : (summary.rentDay == null ? '—' : summary.rentDay)) : '—'}${summary && summary.missingRentDay ? ` <span style=\"color:var(--danger); font-weight:700;\">⚠</span>` : ''}</td>\r\n              <td>${summary ? daysLeftHtml(summary.nearestEnd) : '—'}</td>\r\n              <td><div class=\"row-actions\">\r\n                ${u.role === 'tenant' ? `<button class=\"btn-icon\" data-financial-summary=\"${u.id}\" data-name=\"${escapeHtml(u.name)}\" aria-label=\"Financial summary\" title=\"Financial summary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6\"/></svg></button>` : ''}\r\n                ${u.role === 'tenant' ? `<button class=\"btn-icon\" data-assign-shops=\"${u.id}\" data-name=\"${escapeHtml(u.name)}\" aria-label=\"Assign shops\">${shopAssignIcon()}</button>` : ''}\r\n                <button class=\"btn-icon\" data-reset-pw=\"${u.id}\" data-name=\"${escapeHtml(u.name)}\" aria-label=\"Reset password\" title=\"Reset password\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0110 0v4\"/></svg></button>\r\n                <button class=\"btn-icon\" data-edit-user=\"${u.id}\" aria-label=\"Edit\">${editIcon()}</button>\r\n                <button class=\"btn-icon\" data-delete-user=\"${u.id}\" data-name=\"${escapeHtml(u.name)}\" aria-label=\"Delete\">${trashIcon()}</button>\r\n              </div></td>\r\n            </tr>`;\r\n          }).join('')}\r\n        </tbody>\r\n      </table>\r\n    </div>`}`;\r\n  }\r\n  function shopAssignIcon(){ return `<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l1-5h16l1 5M4 9v10a1 1 0 001 1h14a1 1 0 001-1V9M4 9h16\"/></svg>`; }\r\n\r\n  function attachUserHandlers(){\r\n    document.querySelectorAll('[data-edit-user]').forEach(btn => btn.addEventListener('click', () => openEditUserModal(Number(btn.dataset.editUser))));\r\n    document.querySelectorAll('[data-delete-user]').forEach(btn => btn.addEventListener('click', () => confirmDelete('user', Number(btn.dataset.deleteUser), btn.dataset.name)));\r\n    document.querySelectorAll('[data-assign-shops]').forEach(btn => btn.addEventListener('click', () => openAssignShopsModal(Number(btn.dataset.assignShops), btn.dataset.name)));\r\n    document.querySelectorAll('[data-reset-pw]').forEach(btn => btn.addEventListener('click', () => openResetPasswordModal(Number(btn.dataset.resetPw), btn.dataset.name)));\r\n    document.querySelectorAll('[data-financial-summary]').forEach(btn => btn.addEventListener('click', () => openFinancialSummaryModal(Number(btn.dataset.financialSummary), btn.dataset.name)));\r\n  }\r\n\r\n  /* ================================================================\r\n     BILLS VIEW\r\n     ================================================================ */\r\n  async function billsView(){\r\n    const [bills, users, shops, complexes] = await Promise.all([\r\n      ensureLoaded('bills','/api/bill'),\r\n      ensureLoaded('users','/api/user'),\r\n      ensureLoaded('shops','/api/shop'),\r\n      ensureLoaded('complexes','/api/complex'),\r\n    ]);\r\n    const userName = (id) => users.find(u=>u.id===id)?.name || `#${id}`;\r\n    const userMobile = (id) => users.find(u=>u.id===id)?.mobile || '';\r\n    const shopNum = (id) => shops.find(s=>s.id===id)?.shop_number || `#${id}`;\r\n    const shopComplexId = (id) => shops.find(s=>s.id===id)?.complex_id;\r\n    const complexName = (id) => complexes.find(c=>c.id===id)?.name || '';\r\n    updatePendingBadge(bills.filter(b=>b.status!=='paid').length);\r\n\r\n    const tenants = users.filter(u=>u.role==='tenant');\r\n    return `\r\n    <div class=\"filter-bar\">\r\n      <div class=\"field search-full\">\r\n        <label>Search</label>\r\n        <input class=\"search-input\" id=\"billSearch\" placeholder=\"Tenant name, shop #, complex, bill #…\" style=\"max-width:100%; min-width:0; width:100%;\">\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Complex</label>\r\n        <select id=\"billFilterComplex\">\r\n          <option value=\"\">All complexes</option>\r\n          ${complexes.map(c=>`<option value=\"${c.id}\">${escapeHtml(c.name)}</option>`).join('')}\r\n        </select>\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Tenant</label>\r\n        <select id=\"billFilterUser\">\r\n          <option value=\"\">All tenants</option>\r\n          ${tenants.map(u=>`<option value=\"${u.id}\">${escapeHtml(u.name)}</option>`).join('')}\r\n        </select>\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Status</label>\r\n        <select id=\"billFilterStatus\">\r\n          <option value=\"\">All statuses</option>\r\n          <option value=\"pending\">Pending</option>\r\n          <option value=\"partial\">Partial</option>\r\n          <option value=\"paid\">Paid</option>\r\n          <option value=\"overdue\">Overdue</option>\r\n        </select>\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Type</label>\r\n        <select id=\"billFilterType\">\r\n          <option value=\"\">All types</option>\r\n          ${[...new Set(bills.map(b=>b.bill_type).filter(Boolean))].map(t=>`<option value=\"${escapeHtml(t)}\">${escapeHtml(t)}</option>`).join('')}\r\n        </select>\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Month</label>\r\n        <select id=\"billFilterMonth\">\r\n          <option value=\"\">Any month</option>\r\n          ${Array.from({length:12},(_,i)=>`<option value=\"${i+1}\">${new Date(2000,i).toLocaleString('en-IN',{month:'long'})}</option>`).join('')}\r\n        </select>\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Year</label>\r\n        <input id=\"billFilterYear\" type=\"number\" min=\"2020\" max=\"2099\" placeholder=\"Year\" style=\"width:90px;\">\r\n      </div>\r\n      <div class=\"field\">\r\n        <label>Sort</label>\r\n        <select id=\"billSort\" class=\"sort-select\">\r\n          <option value=\"newest\">Newest first</option>\r\n          <option value=\"oldest\">Oldest first</option>\r\n          <option value=\"due-asc\">Due date ↑</option>\r\n          <optio